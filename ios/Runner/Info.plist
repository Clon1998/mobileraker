    <key>NSUserTrackingUsageDescription</key>
    <string>Mobileraker uses your device's advertising identifier to show you ads that are more relevant to your interests and to measure how well those ads perform. This identifier is not linked to your printer data.</string>
    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-9024548154217588~8054208971</string>
	<key>AwnAppGroupName</key>
	<string>group.mobileraker.awn</string>
